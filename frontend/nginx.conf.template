server {
    listen ${NGINX_PORT};
    root /usr/share/nginx/html;
    index index.html;

    # API calls go to the gateway (no CORS needed: same origin).
    location /api/ {
        proxy_pass ${GATEWAY_URL};
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location / {
        try_files $uri /index.html;
    }
}
